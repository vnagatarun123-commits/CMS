# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Backend selector ─────────────────────────────────────────────────────────
# "mock"     — in-memory mock (default; no DB needed; unit tests always use this)
# "supabase" — real Supabase Auth + Postgres
DATA_BACKEND=mock

# ── Supabase (required when DATA_BACKEND=supabase) ───────────────────────────
# Your app's public URL — used to build absolute redirect URLs (e.g. password reset email).
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Project URL and anon key are safe to expose in client bundles.
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=
# Settings → API → Project API keys → service_role  ← SECRET, never commit
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name (default: "media" — created automatically on first upload)
SUPABASE_STORAGE_BUCKET=media

# ── Prisma / Postgres ────────────────────────────────────────────────────────
# Pooled connection (transaction mode, port 6543) — used by the running app.
# Settings → Database → Connection string → URI (with ?pgbouncer=true appended)
DATABASE_URL=
# Direct connection (port 5432) — used by prisma migrate dev/deploy only.
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=

# ── E2E / integration test gates ────────────────────────────────────────────
# Set RUN_INTEGRATION=1 to run repository contract tests against real Supabase.
# Leave unset (or =0) to run only the mock-backed tests (default for CI).
RUN_INTEGRATION=0

# ── Social Connect OAuth ─────────────────────────────────────────────────────
# Public URL of this app — used to build the OAuth redirect URI.
# Register this exact redirect URI in your Meta and Google consoles:
#   {NEXT_PUBLIC_APP_URL}/api/auth/social/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta app (Instagram + Facebook) — create at developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google OAuth 2.0 client (YouTube) — create at console.cloud.google.com
# Enable "YouTube Data API v3" in the same project
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Org ID pinned to PuraLocal (resolved from session when Supabase auth lands)
PURALOCAL_ORG_ID=org_puralocal

# --- Backend selector ---
# "mock" uses the in-memory mock layer (default for local dev / CI)
# "supabase" wires in Supabase Auth + Postgres (Phase 1)
DATA_BACKEND=mock

# --- Supabase (required when DATA_BACKEND=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

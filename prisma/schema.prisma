generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── Organization ──────────────────────────────────────────────────────────────

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  profiles              Profile[]
  roleAssignments       RoleAssignment[]
  auditLogs             AuditLog[]
  categories            Category[]
  locations             Location[]
  languages             Language[]
  content               Content[]
  roleDefinitions       RoleDefinition[]
  notifications         Notification[]
  notificationTemplates NotificationTemplate[]
  commissionRules       CommissionRule[]
  reporters             Reporter[]
  contributors          Contributor[]

  @@map("organizations")
}

// ── Profile ───────────────────────────────────────────────────────────────────

model Profile {
  id             String    @id
  email          String    @unique
  name           String
  organizationId String    @map("organization_id")
  photoUrl       String?   @map("photo_url")
  phone          String?
  bio            String?
  timezone       String?
  language       String?
  invitedAt      DateTime  @map("invited_at")
  joinedAt       DateTime? @map("joined_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  roleAssignments RoleAssignment[]
  content         Content[]

  @@index([organizationId])
  @@map("profiles")
}

// ── RoleAssignment ────────────────────────────────────────────────────────────

model RoleAssignment {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String
  assignedById   String?  @map("assigned_by_id")
  assignedAt     DateTime @default(now()) @map("assigned_at")

  profile      Profile      @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("role_assignments")
}

// ── RoleDefinition ────────────────────────────────────────────────────────────

model RoleDefinition {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  permissions    String[]
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("role_definitions")
}

// ── AuditLog ──────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  actorId        String   @map("actor_id")
  actorName      String   @map("actor_name")
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  targetLabel    String?  @map("target_label")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("audit_logs")
}

// ── Category ──────────────────────────────────────────────────────────────────

model Category {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  code           String
  name           String
  slug           String
  active         Boolean   @default(true)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  content      Content[]

  @@unique([organizationId, code])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("categories")
}

// ── Location ──────────────────────────────────────────────────────────────────

model Location {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  slug           String
  level          String
  parentId       String?   @map("parent_id")
  active         Boolean   @default(true)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Location?    @relation("LocationParent", fields: [parentId], references: [id])
  children     Location[]   @relation("LocationParent")
  content      Content[]

  @@unique([organizationId, level, slug])
  @@index([organizationId])
  @@index([organizationId, level])
  @@index([parentId])
  @@map("locations")
}

// ── Language ──────────────────────────────────────────────────────────────────

model Language {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  code           String
  name           String
  slug           String
  active         Boolean   @default(true)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  content      Content[]

  @@unique([organizationId, code])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("languages")
}

// ── Content ───────────────────────────────────────────────────────────────────

model Content {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  type           String
  status         String
  source         String
  title          String
  slug           String
  body           String?
  excerpt        String?
  mediaUrl       String?   @map("media_url")
  thumbnailUrl   String?   @map("thumbnail_url")
  imageUrls      String[]  @default([]) @map("image_urls")
  orientation    String?   @map("orientation")
  youtubeUrl     String?   @map("youtube_url")
  categoryId     String?   @map("category_id")
  locationId     String?   @map("location_id")
  languageId     String?   @map("language_id")
  reporterId     String?   @map("reporter_id")
  tags           String[]  @default([])
  isBreakingNews Boolean   @default(false) @map("is_breaking_news")
  isTrending     Boolean   @default(false) @map("is_trending")
  isFeatured     Boolean   @default(false) @map("is_featured")
  scheduledAt    DateTime? @map("scheduled_at")
  publishedAt    DateTime? @map("published_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  category     Category?           @relation(fields: [categoryId], references: [id])
  location     Location?           @relation(fields: [locationId], references: [id])
  language     Language?           @relation(fields: [languageId], references: [id])
  reporter     Profile?            @relation(fields: [reporterId], references: [id])
  transitions  ContentTransition[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("content")
}

// ── ContentTransition ─────────────────────────────────────────────────────────

model ContentTransition {
  id         String   @id @default(cuid())
  contentId  String   @map("content_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorId    String   @map("actor_id")
  actorName  String   @map("actor_name")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("content_transitions")
}

// ── Notification ──────────────────────────────────────────────────────────────

model Notification {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  title               String
  body                String
  imageUrl            String?   @map("image_url")
  deepLink            String?   @map("deep_link")
  channels            String[]
  audience            String
  audienceValue       String?   @map("audience_value")
  priority            String
  status              String
  templateId          String?   @map("template_id")
  scheduledAt         DateTime? @map("scheduled_at")
  sentAt              DateTime? @map("sent_at")
  sentBy              String    @map("sent_by")
  sentByName          String    @map("sent_by_name")
  estimatedRecipients Int       @default(0) @map("estimated_recipients")
  deliveredCount      Int       @default(0) @map("delivered_count")
  openedCount         Int       @default(0) @map("opened_count")
  failedCount         Int       @default(0) @map("failed_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("notifications")
}

// ── NotificationTemplate ──────────────────────────────────────────────────────

model NotificationTemplate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String   @default("")
  title          String
  body           String
  channels       String[]
  audience       String
  priority       String
  category       String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("notification_templates")
}

// ── CommissionRule ────────────────────────────────────────────────────────────

model CommissionRule {
  id                   String   @id
  organizationId       String   @map("organization_id")
  name                 String
  description          String?
  isDefault            Boolean  @default(false) @map("is_default")
  earningMode          String   @map("earning_mode")
  imagePostRateInr     Float    @default(0) @map("image_post_rate_inr")
  videoPostRateInr     Float    @default(0) @map("video_post_rate_inr")
  shortPostRateInr     Float    @default(0) @map("short_post_rate_inr")
  liveSessionRateInr   Float    @default(0) @map("live_session_rate_inr")
  imageCpmInr          Float    @default(0) @map("image_cpm_inr")
  videoCpmInr          Float    @default(0) @map("video_cpm_inr")
  shortCpmInr          Float    @default(0) @map("short_cpm_inr")
  liveCpmInr           Float    @default(0) @map("live_cpm_inr")
  reachBonusThreshold  Int      @default(0) @map("reach_bonus_threshold")
  reachBonusAmountInr  Float    @default(0) @map("reach_bonus_amount_inr")
  viralBonusThreshold  Int      @default(0) @map("viral_bonus_threshold")
  viralBonusAmountInr  Float    @default(0) @map("viral_bonus_amount_inr")
  volumeBonusThreshold Int      @default(0) @map("volume_bonus_threshold")
  volumeBonusAmountInr Float    @default(0) @map("volume_bonus_amount_inr")
  streakBonusMonths    Int      @default(0) @map("streak_bonus_months")
  streakBonusAmountInr Float    @default(0) @map("streak_bonus_amount_inr")
  tdsApplicable        Boolean  @default(false) @map("tds_applicable")
  tdsThresholdInr      Float    @default(0) @map("tds_threshold_inr")
  tdsRatePercent       Float    @default(0) @map("tds_rate_percent")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  reporters    Reporter[]

  @@index([organizationId])
  @@map("commission_rules")
}

// ── Reporter ──────────────────────────────────────────────────────────────────

model Reporter {
  id                      String    @id
  contributorId           String    @map("contributor_id")
  organizationId          String    @map("organization_id")
  name                    String
  photoUrl                String?   @map("photo_url")
  mobile                  String
  email                   String
  designation             String
  district                String
  state                   String?
  reporterType            String    @map("reporter_type")
  language                String?
  coverageAreas           String[]  @default([]) @map("coverage_areas")
  newsGenres              String[]  @default([]) @map("news_genres")
  status                  String
  approvedAt              DateTime? @map("approved_at")
  approvedBy              String?   @map("approved_by")
  commissionRuleId        String?   @map("commission_rule_id")
  payment                 Json?
  stats                   Json?
  lifetimeEarnedInr       Float     @default(0) @map("lifetime_earned_inr")
  lifetimeSettledInr      Float     @default(0) @map("lifetime_settled_inr")
  pendingEarningsInr      Float     @default(0) @map("pending_earnings_inr")
  currentMonthEarningsInr Float     @default(0) @map("current_month_earnings_inr")
  annualEarnedInr         Float     @default(0) @map("annual_earned_inr")
  tdsDeductedInr          Float     @default(0) @map("tds_deducted_inr")
  adminNotes              String?   @map("admin_notes")
  flaggedForReview        Boolean   @default(false) @map("flagged_for_review")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  commissionRule CommissionRule? @relation(fields: [commissionRuleId], references: [id])

  @@index([organizationId])
  @@map("reporters")
}

// ── Contributor ───────────────────────────────────────────────────────────────

model Contributor {
  id                    String    @id @default(cuid())
  contributorId         String    @map("contributor_id")
  organizationId        String    @map("organization_id")
  name                  String
  photoUrl              String?   @map("photo_url")
  status                String
  contributorSource     String    @map("contributor_source")
  mobile                String
  alternateMobile       String?   @map("alternate_mobile")
  email                 String
  dob                   String?
  gender                String?
  occupation            String?
  education             String?
  language              String?
  languagesKnown        String[]  @default([]) @map("languages_known")
  bio                   String?
  address               String?
  houseNumber           String?   @map("house_number")
  street                String?
  area                  String?
  village               String?
  mandal                String?
  district              String
  state                 String?
  pincode               String?
  designation           String
  reporterType          String    @map("reporter_type")
  experience            String?
  contributorType       String?   @map("contributor_type")
  registrationSource    String?   @map("registration_source")
  source                String?
  recruitedBy           String?   @map("recruited_by")
  referralBy            String?   @map("referral_by")
  referralCode          String?   @map("referral_code")
  registrationDate      DateTime? @map("registration_date")
  appliedOn             DateTime  @map("applied_on")
  approvedOn            DateTime? @map("approved_on")
  approvedBy            String?   @map("approved_by")
  rejectedOn            DateTime? @map("rejected_on")
  remarks               String?
  verificationStatus    String?   @map("verification_status")
  verifiedBy            String?   @map("verified_by")
  verificationDate      DateTime? @map("verification_date")
  aadhaarMasked         String?   @map("aadhaar_masked")
  panMasked             String?   @map("pan_masked")
  coverageAreas         String[]  @default([]) @map("coverage_areas")
  newsGenres            String[]  @default([]) @map("news_genres")
  assignedMandal        String?   @map("assigned_mandal")
  assignedVillage       String?   @map("assigned_village")
  coveragePriorityLevel String?   @map("coverage_priority_level")
  accountHolderName     String?   @map("account_holder_name")
  bankName              String?   @map("bank_name")
  accountNumberMasked   String?   @map("account_number_masked")
  ifscCode              String?   @map("ifsc_code")
  branch                String?
  upiId                 String?   @map("upi_id")
  paymentMethod         String?   @map("payment_method")
  panNumber             String?   @map("pan_number")
  deviceInfo            Json?     @map("device_info")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("contributors")
}
